EXPO_PUBLIC_NEWS_API_BASE_URL=https://gnews.io/api/v4
EXPO_PUBLIC_NEWS_API_KEY=your_gnews_api_key_here
EXPO_PUBLIC_NEWS_DEFAULT_COUNTRY=ng
EXPO_PUBLIC_NEWS_DEFAULT_LANGUAGE=en
EXPO_PUBLIC_NEWS_MAX_RESULTS=20
EXPO_PUBLIC_EVENTS_API_BASE_URL=https://api.predicthq.com/v1
EXPO_PUBLIC_PREDICTHQ_API_KEY=your_predicthq_api_key_here
EXPO_PUBLIC_GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash

# AI brief providers (round-robin chain). Set at least one; missing keys disable that provider.
EXPO_PUBLIC_GROQ_API_BASE_URL=https://api.groq.com/openai/v1
EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key_here
EXPO_PUBLIC_GROQ_MODEL=llama-3.1-8b-instant
EXPO_PUBLIC_CEREBRAS_API_BASE_URL=https://api.cerebras.ai/v1
EXPO_PUBLIC_CEREBRAS_API_KEY=your_cerebras_api_key_here
EXPO_PUBLIC_CEREBRAS_MODEL=llama-3.3-70b
EXPO_PUBLIC_OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
EXPO_PUBLIC_OPENROUTER_API_KEY=your_openrouter_api_key_here
EXPO_PUBLIC_OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
